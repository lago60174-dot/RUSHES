NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LLM de l'agent : Claude si ANTHROPIC_API_KEY est défini, sinon Mistral (MISTRAL_API_KEY).
# Tu peux n'utiliser QUE Mistral : laisse ANTHROPIC_API_KEY vide.
ANTHROPIC_API_KEY=
# Optionnel : forcer le fournisseur quand les deux clés existent (mistral ou anthropic)
AGENT_PROVIDER=
# Optionnel : modèle Mistral pour TOUT le projet (agent, inbox, analyse).
# Défaut : mistral-small-latest (marche sur le forfait gratuit). Forfait payant : mistral-large-latest.
MISTRAL_MODEL=
# Mistral : analyse IA ET transcription des vocaux Telegram (Voxtral)
MISTRAL_API_KEY=
# Optionnel : repli pour les vocaux si Mistral est indisponible
OPENAI_API_KEY=
# Optionnel : modèle Claude de l'agent (défaut : claude-haiku-5-5)
AGENT_MODEL=

# App privée : seul cet email peut utiliser l'app (Phase 12)
OWNER_EMAIL=ton@email.com

# Zernio
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_WEBHOOK_SECRET=
CRON_SECRET=

# Cloudflare R2 (stockage des vidéos) — Phase 11
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mymedia
# Domaine public du bucket (custom domain ou URL r2.dev), sans slash final
R2_PUBLIC_URL=

# Bot Telegram (Phase 15)
TELEGRAM_BOT_TOKEN=
# Secret de webhook : 1-256 caractères parmi A-Z a-z 0-9 _ -   (génère-en un long et aléatoire)
TELEGRAM_WEBHOOK_SECRET=
# Ton ID Telegram numérique (le bot te le donne à ton premier message)
TELEGRAM_OWNER_ID=
# URL publique de l'app, sans slash final (liens d'upload et webhook)
NEXT_PUBLIC_SITE_URL=https://ton-projet.vercel.app
# Fuseau horaire des publications programmées (défaut : Africa/Douala)
APP_TIMEZONE=Africa/Douala
# Optionnel : modèle Claude de l'agent Telegram (défaut : claude-sonnet-5-5)
AGENT_CHAT_MODEL=
